#!/usr/bin/env bash
# nwtools — Network troubleshooting menu (Mac / Raspberry Pi)
# Windows ipconfig/arp equivalents

[ "$(uname)" = "Darwin" ] && _OS=darwin || _OS=linux

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_active_iface() {
    if [ "$_OS" = "darwin" ]; then
        route get default 2>/dev/null | awk '/interface:/{print $2}'
    else
        ip route show default 2>/dev/null | awk '/dev/{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}'
    fi
}

_sep() { echo "----------------------------------------"; }

run_tool() {
    local label="$1"; shift
    clear
    echo "Begin $label"
    _sep
    "$@"
    echo ""
    _sep
    echo "End $label"
    echo ""
    read -rp "Press Enter to continue..."
}

# ---------------------------------------------------------------------------
# Core IP display helpers (shared by v4/v6/summary tools)
# ---------------------------------------------------------------------------

# ip addr output for a given AF (4/6/empty=both), docker interfaces excluded
_ip_af() {
    local af="${1:-}"
    case "$af" in
        4) ip -4 addr show ;;
        6) ip -6 addr show ;;
        *) ip addr show ;;
    esac | awk '/^[0-9]+: (docker|br-|veth)/{skip=1;next}/^[0-9]+:/{skip=0}!skip'
}

# Show interface addresses filtered by AF (4/6/empty=both)
_show_ifaces() {
    local af="${1:-}"
    if [ "$_OS" = "darwin" ]; then
        ifconfig | awk -v af="$af" '
            /^[^ \t]/ {
                if (hdr != "" && cnt > 0 && hdr ~ /^(en|utun|lo)[0-9]/) {
                    print hdr
                    for (i = 1; i <= cnt; i++) print buf[i]
                    print ""
                }
                hdr = $0; cnt = 0; split("", buf); next
            }
            /^[ \t]+inet[^6]/ { if (af != "6") buf[++cnt] = $0 }
            /^[ \t]+inet6/    { if (af != "4") buf[++cnt] = $0 }
            /^[ \t]+ether/    { buf[++cnt] = $0 }
            END {
                if (hdr != "" && cnt > 0 && hdr ~ /^(en|utun|lo)[0-9]/) {
                    print hdr
                    for (i = 1; i <= cnt; i++) print buf[i]
                }
            }
        '
    else
        _ip_af "$af"
    fi
}

_ip_no_docker() { _ip_af ""; }

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------

tool_ipconfig()        { _show_ifaces 4; }
tool_ipconfig_v6()     { _show_ifaces 6; }

tool_ipconfig_all() {
    local af="${1:-4}"
    if [ "$_OS" = "darwin" ]; then
        echo "=== Interfaces ==="
        _show_ifaces "$af"
        echo ""
        echo "=== Hardware Ports ==="
        networksetup -listallhardwareports 2>/dev/null
        echo ""
        echo "=== DNS ==="
        scutil --dns 2>/dev/null | head -40
    else
        echo "=== Interfaces ==="
        _show_ifaces "$af"
        echo ""
        if [ "$af" = "6" ]; then
            echo "=== IPv6 Routes ==="
            ip -6 route 2>/dev/null | grep -v -E '^(fe80|ff00)' || true
        else
            echo "=== Routes ==="
            ip route | grep -v -E '^(172\.|10\.42\.)'
        fi
        echo ""
        echo "=== DNS ==="
        cat /etc/resolv.conf
    fi
}

tool_ipconfig_all_v6() { tool_ipconfig_all 6; }

tool_ipconfig_release() {
    local iface
    iface="$(_active_iface)"
    if [ -z "$iface" ]; then
        echo "ERROR: Could not detect active interface."
        return 1
    fi
    echo "Releasing DHCP lease on: $iface"
    if [ "$_OS" = "darwin" ]; then
        sudo ipconfig set "$iface" NONE
    else
        if command -v dhclient >/dev/null 2>&1; then
            sudo dhclient -r "$iface"
        elif command -v dhcpcd >/dev/null 2>&1; then
            sudo dhcpcd --release "$iface"
        else
            echo "ERROR: Neither dhclient nor dhcpcd found."
            echo "Install: sudo apt install isc-dhcp-client   or   sudo apt install dhcpcd5"
            return 1
        fi
    fi
    echo "Done."
}

tool_ipconfig_renew() {
    local iface
    iface="$(_active_iface)"
    if [ -z "$iface" ]; then
        echo "ERROR: Could not detect active interface."
        return 1
    fi
    echo "Renewing DHCP lease on: $iface"
    if [ "$_OS" = "darwin" ]; then
        sudo ipconfig set "$iface" DHCP
    else
        if command -v dhclient >/dev/null 2>&1; then
            sudo dhclient "$iface"
        elif command -v dhcpcd >/dev/null 2>&1; then
            sudo dhcpcd "$iface"
        else
            echo "ERROR: Neither dhclient nor dhcpcd found."
            echo "Install: sudo apt install isc-dhcp-client   or   sudo apt install dhcpcd5"
            return 1
        fi
    fi
    echo "Done."
}

tool_flushdns() {
    if [ "$_OS" = "darwin" ]; then
        sudo dscacheutil -flushcache
        sudo killall -HUP mDNSResponder
        echo "DNS cache flushed."
    else
        if command -v resolvectl >/dev/null 2>&1; then
            sudo resolvectl flush-caches && echo "DNS cache flushed (resolvectl)."
        elif command -v systemd-resolve >/dev/null 2>&1; then
            sudo systemd-resolve --flush-caches && echo "DNS cache flushed (systemd-resolve)."
        elif [ -x /etc/init.d/dns-clean ]; then
            sudo /etc/init.d/dns-clean restart && echo "DNS cache flushed (dns-clean)."
        else
            echo "No DNS flush tool found (resolvectl / systemd-resolve / dns-clean)."
            echo "Current /etc/resolv.conf:"
            cat /etc/resolv.conf
        fi
    fi
}

tool_arp_a() {
    if command -v arp >/dev/null 2>&1; then
        arp -a
    elif [ "$_OS" = "linux" ]; then
        ip neigh show
    else
        echo "ERROR: arp not found."
        return 1
    fi
}

tool_arp_d() {
    echo "Clearing ARP cache ..."
    if [ "$_OS" = "darwin" ]; then
        sudo arp -d -a
    else
        sudo ip neigh flush all
    fi
    echo "Done."
}

tool_ping_gateway() {
    local gw
    if [ "$_OS" = "darwin" ]; then
        gw=$(route get default 2>/dev/null | awk '/gateway:/{print $2}')
    else
        gw=$(ip route show default 2>/dev/null | awk '/default via/{print $3; exit}')
    fi
    if [ -z "$gw" ]; then
        echo "ERROR: Could not detect default gateway."
        return 1
    fi
    echo "Pinging gateway: $gw"
    echo ""
    ping -c 4 "$gw"
}

tool_ping_internet() {
    echo "Pinging 8.8.8.8 ..."
    echo ""
    ping -c 4 8.8.8.8
}

tool_traceroute() {
    read -rp "Target host [default: 8.8.8.8]: " target
    target="${target:-8.8.8.8}"
    echo ""
    if [ "$_OS" = "darwin" ]; then
        traceroute "$target"
    else
        if command -v mtr >/dev/null 2>&1; then
            mtr --report --report-cycles 5 "$target"
        elif command -v traceroute >/dev/null 2>&1; then
            traceroute "$target"
        elif command -v tracepath >/dev/null 2>&1; then
            tracepath "$target"
        else
            echo "ERROR: No traceroute tool found."
            echo "Install: sudo apt install traceroute   or   sudo apt install mtr-tiny"
            return 1
        fi
    fi
}

tool_dns_lookup() {
    read -rp "Hostname [default: google.com]: " host
    host="${host:-google.com}"
    read -rp "Record type [A/AAAA/MX/NS/TXT, default: A]: " rtype
    rtype="${rtype:-A}"
    echo ""
    if command -v dig >/dev/null 2>&1; then
        dig "$host" "$rtype"
    elif command -v nslookup >/dev/null 2>&1; then
        nslookup -type="$rtype" "$host"
    elif command -v host >/dev/null 2>&1; then
        host -t "$rtype" "$host"
    else
        echo "Trying getent ..."
        getent hosts "$host" 2>/dev/null || {
            echo "ERROR: No DNS lookup tool found (dig / nslookup / host)."
            echo "Install: sudo apt install dnsutils"
            return 1
        }
    fi
}

tool_route_table() {
    if [ "$_OS" = "darwin" ]; then
        netstat -rn
    else
        ip route
        echo ""
        echo "=== IPv6 ==="
        ip -6 route 2>/dev/null || true
    fi
}

tool_connections() {
    if [ "$_OS" = "darwin" ]; then
        netstat -an | grep -E 'LISTEN|ESTABLISHED'
    else
        if command -v ss >/dev/null 2>&1; then
            ss -tulpn
        else
            netstat -tulpn 2>/dev/null || echo "ERROR: neither ss nor netstat found."
        fi
    fi
}

tool_external_ip() {
    echo "Fetching external IP ..."
    echo ""
    if command -v curl >/dev/null 2>&1; then
        curl -s --max-time 5 https://ifconfig.me && echo ""
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- --timeout=5 https://ifconfig.me && echo ""
    else
        echo "ERROR: curl and wget not found."
        return 1
    fi
}

tool_port_test() {
    read -rp "Host: " pt_host
    read -rp "Port: " pt_port
    if [ -z "$pt_host" ] || [ -z "$pt_port" ]; then
        echo "ERROR: Host and port required."
        return 1
    fi
    echo ""
    echo "Testing $pt_host:$pt_port ..."
    if command -v nc >/dev/null 2>&1; then
        nc -zv -w 5 "$pt_host" "$pt_port"
    else
        echo "ERROR: nc (netcat) not found. Install: sudo apt install netcat"
        return 1
    fi
}

tool_wifi_info() {
    if [ "$_OS" = "darwin" ]; then
        local airport="/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport"
        if [ -x "$airport" ]; then
            "$airport" -I
        else
            networksetup -getairportnetwork en0 2>/dev/null || echo "airport utility not found."
        fi
    else
        if command -v iwconfig >/dev/null 2>&1; then
            local out
            out=$(iwconfig 2>/dev/null)
            if echo "$out" | grep -q 'ESSID\|IEEE'; then
                echo "$out"
            else
                echo "(No wireless interfaces detected via iwconfig)"
                echo "$out"
            fi
        elif command -v iw >/dev/null 2>&1; then
            iw dev
        else
            echo "ERROR: Neither iwconfig nor iw found."
            echo "Install: sudo apt install wireless-tools   or   sudo apt install iw"
            return 1
        fi
    fi
}

tool_wol() {
    read -rp "MAC address (e.g. aa:bb:cc:dd:ee:ff): " wol_mac
    if [ -z "$wol_mac" ]; then
        echo "ERROR: MAC address required."
        return 1
    fi
    echo ""
    if command -v wakeonlan >/dev/null 2>&1; then
        wakeonlan "$wol_mac"
    elif command -v wol >/dev/null 2>&1; then
        wol "$wol_mac"
    else
        echo "ERROR: wakeonlan / wol not found. Install: sudo apt install wakeonlan"
        return 1
    fi
}

# Interface summary: one line per interface showing state, IPv4, IPv6
tool_iface_summary() {
    printf "%-14s %-8s %-20s %s\n" "INTERFACE" "STATE" "IPv4" "IPv6"
    printf "%-14s %-8s %-20s %s\n" "---------" "-----" "----" "----"
    if [ "$_OS" = "darwin" ]; then
        ifconfig | awk '
            /^[^ \t]/ {
                if (iface != "" && (ipv4 != "" || ipv6 != ""))
                    printf "%-14s %-8s %-20s %s\n", iface, state, ipv4, ipv6
                iface = substr($1, 1, length($1) - 1)
                state = /UP/ ? "UP" : "DOWN"
                ipv4 = ""; ipv6 = ""
            }
            /^[ \t]+inet[^6]/  { if (ipv4 == "") ipv4 = $2 }
            /^[ \t]+inet6 /    { if (ipv6 == "" && $2 !~ /^fe80/) ipv6 = $2 }
            END {
                if (iface != "" && (ipv4 != "" || ipv6 != ""))
                    printf "%-14s %-8s %-20s %s\n", iface, state, ipv4, ipv6
            }
        '
    else
        ip -brief addr show 2>/dev/null | \
            awk '!/docker|veth|br-/{
                # strip fe80 link-local from IPv6 column ($4+)
                ipv6=""
                for (i=4; i<=NF; i++) { if ($i !~ /^fe80/) { ipv6=$i; break } }
                printf "%-14s %-8s %-20s %s\n", $1, $2, $3, ipv6
            }'
    fi
}

# Bandwidth / latency test: gateway ping, internet ping, Cloudflare download
tool_bw_test() {
    local gw
    echo "=== Latency ==="
    if [ "$_OS" = "darwin" ]; then
        gw=$(route get default 2>/dev/null | awk '/gateway:/{print $2}')
    else
        gw=$(ip route show default 2>/dev/null | awk '/default via/{print $3; exit}')
    fi
    if [ -n "$gw" ]; then
        echo "Gateway ($gw):"
        ping -c 5 "$gw" | tail -2
        echo ""
    fi
    echo "Internet (8.8.8.8):"
    ping -c 5 8.8.8.8 | tail -2
    echo ""
    echo "=== Download Speed (25 MB from Cloudflare) ==="
    if command -v curl >/dev/null 2>&1; then
        echo -n "Testing..."
        local speed
        speed=$(curl -s -o /dev/null -w "%{speed_download}" \
            --max-time 30 "https://speed.cloudflare.com/__down?bytes=26214400" 2>/dev/null)
        if [ -n "$speed" ] && [ "$speed" != "0" ]; then
            awk -v b="$speed" 'BEGIN{printf " %.1f MB/s\n", b/1048576}'
        else
            echo " (test failed or timed out)"
        fi
    elif command -v wget >/dev/null 2>&1; then
        wget -O /dev/null --timeout=30 \
            "https://speed.cloudflare.com/__down?bytes=26214400" 2>&1 | tail -3
    else
        echo "curl/wget not found — cannot test download speed."
    fi
}

# ---------------------------------------------------------------------------
# Menu
# ---------------------------------------------------------------------------

# Direct invocation: nw <choice> — run tool and exit, no interactive wrapper
if [ -n "${1:-}" ]; then
    case "$1" in
        1) tool_ipconfig ;;
        i) tool_ipconfig_v6 ;;
        2) tool_ipconfig_all ;;
        j) tool_ipconfig_all_v6 ;;
        3) tool_ipconfig_release ;;
        4) tool_ipconfig_renew ;;
        5) tool_flushdns ;;
        6) tool_arp_a ;;
        7) tool_arp_d ;;
        8) tool_ping_gateway ;;
        9) tool_ping_internet ;;
        a) tool_traceroute ;;
        b) tool_dns_lookup ;;
        c) tool_route_table ;;
        d) tool_connections ;;
        e) tool_external_ip ;;
        f) tool_port_test ;;
        g) tool_wifi_info ;;
        h) tool_wol ;;
        k) tool_iface_summary ;;
        l) tool_bw_test ;;
        *) echo "Unknown choice: $1" >&2; exit 1 ;;
    esac
    exit 0
fi

while true; do
    clear
    echo "======================================="
    echo "  Network Tools"
    echo "======================================="
    echo "1.  ipconfig            IPv4 addresses"
    echo "i.  ipconfig v6         IPv6 addresses"
    echo "2.  ipconfig /all       IPv4 full details"
    echo "j.  ipconfig /all v6    IPv6 full details"
    echo "3.  ipconfig /release   release DHCP lease"
    echo "4.  ipconfig /renew     renew DHCP lease"
    echo "5.  ipconfig /flushdns  flush DNS cache"
    echo "6.  arp -a              show ARP table"
    echo "7.  arp -d              clear ARP table"
    echo "---------------------------------------"
    echo "8.  ping gateway        ping default gateway"
    echo "9.  ping 8.8.8.8        internet connectivity"
    echo "a.  traceroute          trace route to host"
    echo "b.  dns lookup          dig A/AAAA/MX/NS/TXT"
    echo "c.  routing table       show routes"
    echo "d.  connections         active/listening ports"
    echo "e.  external IP         whatismyip"
    echo "f.  port test           nc -zv host port"
    echo "g.  wifi info           wireless details"
    echo "h.  wake-on-LAN         send WOL magic packet"
    echo "---------------------------------------"
    echo "k.  iface summary       interface overview table"
    echo "l.  bandwidth test      latency + download speed"
    echo "---------------------------------------"
    echo "0.  Exit"
    echo ""
    read -rp "Choice: " choice

    case "$choice" in
        1) run_tool "ipconfig"            tool_ipconfig ;;
        i) run_tool "ipconfig v6"         tool_ipconfig_v6 ;;
        2) run_tool "ipconfig /all"       tool_ipconfig_all ;;
        j) run_tool "ipconfig /all v6"    tool_ipconfig_all_v6 ;;
        3) run_tool "ipconfig /release"   tool_ipconfig_release ;;
        4) run_tool "ipconfig /renew"     tool_ipconfig_renew ;;
        5) run_tool "ipconfig /flushdns"  tool_flushdns ;;
        6) run_tool "arp -a"              tool_arp_a ;;
        7) run_tool "arp -d"              tool_arp_d ;;
        8) run_tool "ping gateway"        tool_ping_gateway ;;
        9) run_tool "ping 8.8.8.8"        tool_ping_internet ;;
        a) run_tool "traceroute"          tool_traceroute ;;
        b) run_tool "dns lookup"          tool_dns_lookup ;;
        c) run_tool "routing table"       tool_route_table ;;
        d) run_tool "connections"         tool_connections ;;
        e) run_tool "external IP"         tool_external_ip ;;
        f) run_tool "port test"           tool_port_test ;;
        g) run_tool "wifi info"           tool_wifi_info ;;
        h) run_tool "wake-on-LAN"         tool_wol ;;
        k) run_tool "iface summary"       tool_iface_summary ;;
        l) run_tool "bandwidth test"      tool_bw_test ;;
        0|'') echo "Exiting..."; exit 0 ;;
        *) echo "Invalid choice."; sleep 1 ;;
    esac
done
