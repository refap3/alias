# Keep this wildcard last: ssh resolves each keyword to its first match, so any
# host needing a different IdentityFile or User must appear above it.
Host 192.168.1.* *.ssb8.local *.pi.hole mb.local mm.local mb mm
    ForwardAgent yes
    SendEnv -LANG -LC_*
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    IdentityFile ~/.ssh/id_rsa
    LogLevel ERROR
